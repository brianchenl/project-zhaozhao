---
interface Props {
  lang?: string;
  sources: { title: string; url: string; publisher: string; locator: string; accessed: string }[];
}
import { t } from '../lib/i18n';
const { sources, lang = 'zh-CN' } = Astro.props;
const u = t(lang);
---
<section aria-label={u.sources}>
  <h2>{u.sources}</h2>
  <ol class="sources">
    {sources.map((s, i) => <li id={`source-${i + 1}`}>
      <a href={s.url}>{s.title}</a>（{s.publisher}）<br />
      {s.locator} · {u.accessed}: <time datetime={s.accessed}>{s.accessed}</time>
    </li>)}
  </ol>
</section>
